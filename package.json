{
  "name": "iwoho-launcher",
  "version": "1.0.0",
  "description": "Iwoho Visuals — Minecraft launcher",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "dependencies": {
    "minecraft-launcher-core": "^3.18.2"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.iwoho.launcher",
    "productName": "Iwoho Launcher",
    "win": {
      "target": "nsis"
    },
    "files": [
      "src/**",
      "assets/**",
      "package.json"
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}