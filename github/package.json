{
  "name": "iwoho-launcher",
  "version": "1.0.0",
  "description": "Iwoho Visuals - Minecraft launcher",
  "author": "Iwoho",
  "main": "main.js",
  "scripts": { "start": "electron .", "build": "electron-builder" },
  "dependencies": { "minecraft-launcher-core": "^3.18.2" },
  "devDependencies": { "electron": "^31.0.0", "electron-builder": "^24.13.3" },
  "build": {
    "appId": "com.iwoho.launcher",
    "productName": "Iwoho Launcher",
    "files": ["main.js", "preload.js", "index.html", "splash.html", "logo.svg", "video1.mp4", "video2.mp4", "package.json"],
    "win": { "target": "nsis" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true }
  }
}
